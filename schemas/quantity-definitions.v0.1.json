      "accepted_conversion_policies": ["linear_ratio"],
      "constraints": {
        "domain": "canonical_magnitude",
        "minimum": 0
      }
    },
    {
      "quantity_id": "photonics.loss",
      "display_name": "Optical power-ratio loss",

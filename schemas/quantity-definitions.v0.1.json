      "quantity_id": "photonics.optical_wavelength",
      "display_name": "Optical wavelength",
      "value_kind": "numeric",
      "physical_dimension": "[length]",
      "canonical_unit": "m",
      "accepted_conversion_policies": ["linear_si"],
      "constraints": {
        "domain": "canonical_magnitude",
        "exclusive_minimum": 0
      }
    },
    {
      "quantity_id": "photonics.optical_power",
      "display_name": "Optical power",
      "value_kind": "numeric",
      "physical_dimension": "[mass] * [length] ** 2 / [time] ** 3",
      "canonical_unit": "W",
      "accepted_conversion_policies": [
        "linear_si",
        "log_absolute_power_dbm"
      ],
      "constraints": {
        "domain": "canonical_magnitude",
        "minimum": 0
      },
      "description": "dBm input is absolute logarithmic power referenced to 1 mW and never uses generic linear conversion."
    },
    {
      "quantity_id": "photonics.transmission",
      "display_name": "Optical power transmission",
      "value_kind": "numeric_ratio",

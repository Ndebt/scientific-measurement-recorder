      "physical_dimension": "dimensionless",
      "canonical_unit": "dB",
      "accepted_conversion_policies": ["log_power_ratio_loss_db"],
      "description": "Power-ratio loss uses loss_dB = 10 * log10(P_in / P_out), not an amplitude-ratio convention."

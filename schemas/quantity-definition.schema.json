{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ndebt/scientific-measurement-recorder/blob/main/schemas/quantity-definition.schema.json",
  "title": "Scientific Measurement Recorder quantity-definition seed",
  "description": "Repository schema for a versioned set of quantity definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "definition_set_version",
    "status",
    "quantity_definitions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "definition_set_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
    },
    "status": {
      "enum": ["draft", "stable", "deprecated"]
    },
    "quantity_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/quantityDefinition"
      }
    }
  },
  "$defs": {
    "quantityDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity_id",
        "display_name",
        "value_kind",
        "physical_dimension",
        "canonical_unit",
        "accepted_conversion_policies"
      ],
      "properties": {
        "quantity_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "value_kind": {
          "enum": [
            "numeric",
            "numeric_ratio",
            "numeric_logarithmic_power_ratio_loss",
            "categorical_controlled_text"
          ]
        },
        "physical_dimension": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "canonical_unit": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "accepted_conversion_policies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "constraints": {
          "$ref": "#/$defs/constraints"
        },
        "allowed_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value_kind": {
                "const": "categorical_controlled_text"
              }
            },
            "required": ["value_kind"]
          },
          "then": {
            "required": ["allowed_values"],
            "properties": {
              "physical_dimension": {
                "type": "null"
              },
              "canonical_unit": {
                "type": "null"
              },
              "accepted_conversion_policies": {
                "const": ["controlled_text"]
              }
            }
          },
          "else": {
            "properties": {
              "physical_dimension": {
                "type": "string"
              },
              "canonical_unit": {
                "type": "string"
              }
            },
            "not": {
              "required": ["allowed_values"]
            }
          }
        }
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain"],
      "properties": {
        "domain": {
          "enum": ["canonical_magnitude", "categorical_value"]
        },
        "minimum": {
          "type": "number"
        },
        "exclusive_minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "exclusive_maximum": {
          "type": "number"
        }
      }
    }
  }
}
